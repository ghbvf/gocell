# This is a TEMPLATE. Run `scripts/gen-deploy-secrets.sh` to generate
# `.env.local` (gitignored) with cryptographically random values.
# DO NOT use these placeholders as actual secrets.
#
# JWT keypair is intentionally absent: corebundle generates an ephemeral RSA
# keypair at container start (tokens invalidate on restart). For persistent
# keypair across restarts, see docs/ops/local-docker-deploy.md §Production
# differences.

PG_PASSWORD=<hex-16>
GOCELL_APP_PASSWORD=<hex-16>  # URL-safe (embedded in serving DSN userinfo)
RABBITMQ_PASSWORD=<hex-16>   # URL-safe (embedded in GOCELL_AMQP_URL userinfo); #1940 postgres event broker
CONFIGCORE_MASTER_KEY=<64-char-hex>
CONFIGCORE_CURSOR_KEY=<min-32-byte-base64>
AUDITCORE_HMAC_KEY=<min-32-byte-base64>
AUDITCORE_CURSOR_KEY=<min-32-byte-base64>
ACCESSCORE_CURSOR_KEY=<min-32-byte-base64>
ACCESSCORE_IP_HASH_SALT=<min-32-byte-base64>
SERVICE_SECRET=<min-32-byte-base64>
METRICS_TOKEN=<min-32-byte-base64>
READYZ_VERBOSE_TOKEN=<hex-32>
OPS_USER=ops
OPS_PASS=<hex-12>
