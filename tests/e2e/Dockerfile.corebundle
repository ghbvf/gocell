# Multi-stage build of cmd/corebundle for the e2e docker-compose harness.
# Build context is the gocell repo root; the repo-root .dockerignore narrows
# it. Final image runs corebundle as a non-root user; the JWT keypair handling
# (ephemeral RSA generation when env not provided, passthrough when env-injected)
# lives in tests/e2e/start-corebundle.sh — a standalone script that is shellcheck-
# linted (via hack/verify-shellcheck.sh) and behavior-tested (via
# hack/verify-local-compose.sh fake-PATH double-scenario test).

FROM golang:1.25-alpine AS build
WORKDIR /src
RUN apk add --no-cache git
# Since #1565 the repo root is a pure go.work workspace (no root go.mod/go.sum),
# so the former `COPY go.mod go.sum` + `go mod download` pre-warm layer no longer
# applies — `go -C cmd/corebundle build` resolves and downloads via the copied
# go.work workspace (GOWORK auto-detected from /src).
# Recursive COPY is intentional and bounded by the repo-root .dockerignore
# (.git, .claude, docs/, worktrees/, bak/, *.env, coverage*.out filtered).
# Multi-stage isolation: the build stage filesystem is discarded after
# `go build`; only /out/corebundle crosses into the runtime image.
COPY . .
# cmd/corebundle is its own go.work module (#1559); `go -C cmd/corebundle build`
# resolves the sibling cellmodules + base modules via the copied go.work (GOWORK
# auto-detected from /src). A root-relative `./cmd/corebundle` would not cross the
# nested-module boundary.
RUN CGO_ENABLED=0 go -C cmd/corebundle build -o /out/corebundle .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates curl openssl \
    && adduser -D -H -u 10001 gocell \
    && mkdir -p /run/gocell \
    && chown gocell:gocell /run/gocell
COPY tests/e2e/start-corebundle.sh /usr/local/bin/start-corebundle.sh
COPY --from=build /out/corebundle /usr/local/bin/corebundle
RUN chmod +x /usr/local/bin/start-corebundle.sh
USER gocell
EXPOSE 8080 9090 9091
ENTRYPOINT ["/usr/local/bin/start-corebundle.sh"]
