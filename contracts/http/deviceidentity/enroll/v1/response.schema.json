{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http.deviceidentity.enroll.v1.response",
  "type": "object",
  "required": ["data"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate", "chain", "serial", "notBefore", "notAfter", "epoch", "status"],
      "properties": {
        "certificate": {
          "type": "string",
          "maxLength": 16384,
          "description": "Issued leaf certificate, base64-encoded DER (X.509)."
        },
        "chain": {
          "type": "string",
          "maxLength": 65536,
          "description": "PKCS#7 certs-only chain (leaf→root), base64-encoded DER."
        },
        "serial": {
          "type": "string",
          "maxLength": 128,
          "description": "Certificate serial number (hex, RFC 5280 §4.1.2.2)."
        },
        "notBefore": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "notAfter": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic issuance epoch; increments on each rotation."
        },
        "status": {
          "type": "string",
          "description": "Certificate lifecycle state.",
          "enum": [
            "requested",
            "issued",
            "active",
            "near-expiry",
            "renewing",
            "rotated",
            "revoked",
            "expired"
          ]
        },
        "deviceId": {
          "type": "string",
          "maxLength": 256
        },
        "issuer": {
          "type": "string",
          "maxLength": 256,
          "description": "Issuing CA identifier (provider-neutral; lets a multi-CA consumer correlate this cert to its issuer)."
        }
      }
    }
  }
}
