{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http.deviceidentity.status.v1.response",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "deviceId",
        "certRef",
        "status",
        "notBefore",
        "notAfter",
        "epoch"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "maxLength": 256
        },
        "certRef": {
          "$ref": "../../../../shared/deviceidentity/v1/certificate-identity.schema.json"
        },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "issued",
            "active",
            "near-expiry",
            "renewing",
            "rotated",
            "revoked",
            "expired"
          ]
        },
        "notBefore": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "notAfter": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "renewalTime": {
          "type": ["string", "null"],
          "format": "date-time",
          "maxLength": 64
        }
      }
    }
  }
}
