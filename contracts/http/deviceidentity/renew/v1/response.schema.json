{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http.deviceidentity.renew.v1.response",
  "type": "object",
  "required": ["data"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate", "chain", "serial", "notBefore", "notAfter", "epoch", "status"],
      "properties": {
        "certificate": {
          "type": "string",
          "maxLength": 16384
        },
        "chain": {
          "type": "string",
          "maxLength": 65536
        },
        "serial": {
          "type": "string",
          "maxLength": 128
        },
        "notBefore": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "notAfter": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "issued",
            "active",
            "near-expiry",
            "renewing",
            "rotated",
            "revoked",
            "expired"
          ]
        },
        "deviceId": {
          "type": "string",
          "maxLength": 256
        },
        "priorSerial": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  }
}
