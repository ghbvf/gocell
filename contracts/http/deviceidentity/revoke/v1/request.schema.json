{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http.deviceidentity.revoke.v1.request",
  "type": "object",
  "required": ["serial", "deviceId", "reason"],
  "additionalProperties": false,
  "properties": {
    "serial": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenantId": {
      "type": "string",
      "maxLength": 256
    },
    "issuer": {
      "type": "string",
      "maxLength": 256
    },
    "reason": {
      "type": "string",
      "maxLength": 32,
      "description": "RFC 5280 §5.3.1 CRLReason code. Full standard set retained for provider-neutral alignment; consumers should treat certificateHold/removeFromCRL per RFC 5280 semantics (hold / un-hold), not as permanent revocation.",
      "enum": [
        "unspecified",
        "keyCompromise",
        "caCompromise",
        "affiliationChanged",
        "superseded",
        "cessationOfOperation",
        "certificateHold",
        "removeFromCRL",
        "privilegeWithdrawn",
        "aaCompromise"
      ]
    }
  }
}
