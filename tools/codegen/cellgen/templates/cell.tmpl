{{template "header" .}}

import (
	"context"
{{- if or .Subscriptions .WebhookReceivers .WebhookDispatches .Projections .GrpcServices }}
	"fmt"
{{- end }}

	"github.com/ghbvf/gocell/framework/kernel/cell"
	"github.com/ghbvf/gocell/framework/kernel/metadata"
{{- if .HTTPMethodPermissions }}
	"github.com/ghbvf/gocell/framework/runtime/auth"
{{- end }}
{{- if or .WebhookReceivers .WebhookDispatches }}
	webhook "github.com/ghbvf/gocell/framework/kernel/webhook"
{{- end }}
{{- range .Subscriptions }}
	{{.SubscriptionAlias}} "{{.SubscriptionPackage}}"
{{- end }}
{{- range .Projections }}{{- if not .IsSagaJournal }}
	{{.SpecAlias}} "{{.SpecPackage}}"
{{- end }}{{- end }}
{{- if .GrpcServices }}
	"google.golang.org/grpc"
{{- end }}
{{- range .GrpcServices }}
	{{.PbAlias}} "{{.PbImportPath}}"
{{- end }}
)

var _ cell.Cell = (*{{.StructName}})(nil)

// cellMeta is the canonical metadata literal projected from cell.yaml.
// loadCellMetadata returns the package-scope pointer; cell.go's constructor
// passes it to cell.MustNewBaseCell which deep-copies the value so callers
// cannot mutate the generated literal.
var cellMeta = {{ .RenderedMetaLiteral }}

func loadCellMetadata() *metadata.CellMeta { return cellMeta.Clone() }
{{- if .HTTPMethodPermissions }}

// cellHTTPResolver is the cell-level authz.MethodPolicyResolver (#2205), built from
// the served HTTP contracts' endpoints.http.permission overlays. cell_init.go injects
// it into the contract-derived slice handlers' NewHandler(svc, resolver); it is the
// HTTP sibling of the gRPC registrar's per-method permission map. An action outside
// the closed authz registry would fail-fast here at construction.
var cellHTTPResolver = auth.NewStaticMethodPolicyResolver(map[string]string{
{{- range .HTTPMethodPermissions }}
	{{ printf "%q" .FullMethod }}: {{ printf "%q" .Permission }},
{{- end }}
})
{{- end }}

//nolint:gocognit // generated code: complexity intrinsic to cell's subscribe count
func (c *{{.StructName}}) Init(ctx context.Context, reg cell.Registrar) error {
	if err := c.BaseCell.Init(ctx, reg); err != nil {
		return err
	}
	// initInternal: hand-written init hook (permanent K#04 convention; implement in cell.go)
	if err := c.initInternal(ctx, reg); err != nil {
		return err
	}
{{ range .RouteGroups }}
	reg.RouteGroup(cell.RouteGroup{
		Listener: {{ .ListenerConst }},
		Prefix:   {{ printf "%q" .Prefix }},
		Register: func(mux cell.RouteMux) error {
			var firstErr error
			captureErr := func(err error) {
				if err != nil && firstErr == nil {
					firstErr = err
				}
			}
{{- range .SubRoutes }}
{{- if .SubPath }}
			mux.Route({{ printf "%q" .SubPath }}, func(s cell.RouteMux) {
{{- range .Mounts }}
				captureErr(c.{{ .HandlerField }}.{{ .Method }}(s))
{{- end }}
			})
{{- else }}
{{- range .Mounts }}
			captureErr(c.{{ .HandlerField }}.{{ .Method }}(mux))
{{- end }}
{{- end }}
{{- end }}
			return firstErr
		},
	})
{{ end }}
{{- range .Subscriptions }}
	{{/* $.CellID is the HARD positional cellID parameter on Registry.Subscribe. Codegen injects it
	     from cell metadata (cell.yaml id) at code-generation time so that callers cannot omit it
	     without a compile failure. Changing this to an option would demote the contract from
	     compile-time HARD to opt-in Soft — rejected by REGISTRY-SUBSCRIBE-CELLID-MANDATORY-01.
	     ref: ADR docs/architecture/202605111000-adr-subscription-cellid-mandatory.md */}}
	if err := {{.SubscriptionAlias}}.NewSubscription({{.HandlerExpr}}, {{ if .ConsumerGroup }}{{ printf "%q" .ConsumerGroup }}{{ else }}{{ printf "%q" $.ConsumerGroupDefault }}{{ end }}, {{ printf "%q" $.CellID }}, {{ printf "%q" .SliceID }}).Mount(reg); err != nil {
		return fmt.Errorf({{ printf "%q" (printf "%s: subscribe %s: %%w" $.CellID .ContractID) }}, err)
	}
{{ end }}
{{- range .WebhookReceivers }}
	if err := reg.RegisterWebhookReceiver(webhook.ReceiverSpec{
		ContractID:       {{ printf "%q" .ContractID }},
		SourceID:         {{ printf "%q" .SourceID }},
		CellID:           {{ printf "%q" $.CellID }},
		PathPattern:      {{ printf "%q" .PathPattern }},
		DeliveryIDHeader: {{ printf "%q" .DeliveryIDHeader }},
		TimestampHeader:  {{ printf "%q" .TimestampHeader }},
		SignatureHeader:  {{ printf "%q" .SignatureHeader }},
		ToleranceSeconds: {{ .ToleranceSeconds }},
		MaxBodyBytes:     {{ .MaxBodyBytes }},
	}, {{ .HandlerExpr }}); err != nil {
		return fmt.Errorf({{ printf "%q" (printf "%s: webhook-receive %s: %%w" $.CellID .ContractID) }}, err)
	}
{{ end }}
{{- range .WebhookDispatches }}
	if err := reg.RegisterWebhookDispatch(webhook.DispatchSpec{
		ContractID: {{ printf "%q" .ContractID }},
		SourceID:   {{ printf "%q" .SourceID }},
		CellID:     {{ printf "%q" $.CellID }},
	}, {{ .SelectorExpr }}); err != nil {
		return fmt.Errorf({{ printf "%q" (printf "%s: webhook-dispatch %s: %%w" $.CellID .ContractID) }}, err)
	}
{{ end }}
{{- range .Projections }}
{{- if .IsSagaJournal }}
	if err := reg.RegisterProjection(cell.NewSagaJournalProjectionRequest(
		{{.ApplyExpr}}, {{ printf "%q" .ProjectionID }}, {{ printf "%q" $.CellID }}, {{ printf "%q" .SliceID }},
	)); err != nil {
		return fmt.Errorf({{ printf "%q" (printf "%s: projection %s: %%w" $.CellID .ProjectionID) }}, err)
	}
{{- else }}
	if err := reg.RegisterProjection({{.SpecAlias}}.NewProjectionRequest(
		{{.ApplyExpr}}, {{ printf "%q" .ProjectionID }}, {{ printf "%q" $.CellID }}, {{ printf "%q" .SliceID }}, {{ if .OnResetExpr }}{{ .OnResetExpr }}{{ else }}nil{{ end }},
	)); err != nil {
		return fmt.Errorf({{ printf "%q" (printf "%s: projection %s: %%w" $.CellID .ProjectionID) }}, err)
	}
{{- end }}
{{ end }}
{{- range .GrpcServices }}
	if err := reg.GRPCService(cell.GRPCServiceSpec{
		ContractID: {{ printf "%q" .ContractID }},
		CellID:     {{ printf "%q" $.CellID }},
		Listener:   {{ .ListenerConst }},
{{- if .PublicMethods }}
		PublicMethods: []string{
{{- range .PublicMethods }}
			{{ printf "%q" . }},
{{- end }}
		},
{{- end }}
{{- if .MethodPermissions }}
		MethodPermissions: map[string]string{
{{- range .MethodPermissions }}
			{{ printf "%q" .FullMethod }}: {{ printf "%q" .Permission }},
{{- end }}
		},
{{- end }}
{{- if .MethodResources }}
		MethodResources: map[string]string{
{{- range .MethodResources }}
			{{ printf "%q" .FullMethod }}: {{ printf "%q" .Field }},
{{- end }}
		},
{{- end }}
		Register: func(r grpc.ServiceRegistrar) {
			{{.PbAlias}}.{{.RegisterFunc}}(r, c.{{.HandlerField}})
		},
	}); err != nil {
		return fmt.Errorf({{ printf "%q" (printf "%s: grpc-serve %s: %%w" $.CellID .ContractID) }}, err)
	}
{{ end }}
	return nil
}
