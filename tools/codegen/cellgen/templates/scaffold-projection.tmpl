{{end}}

{{define "projection-contract-yaml"}}id: projection.{{.CellNoDash}}.summary.v1
kind: projection
ownerCell: {{.CellID}}
consistencyLevel: L3
lifecycle: experimental
replayable: true
endpoints:
  provider: {{.CellID}}
schemaRefs:
  payload: payload.schema.json
{{end}}

