{{define "projection-slice-yaml"}}id: {{.SliceID}}
belongsToCell: {{.CellID}}
# L3=WorkflowEventual — projection slices consume events to build a read model
consistencyLevel: L3
lifecycle: experimental
contractUsages:
  - contract: event.{{.CellNoDash}}.example.v1
    role: subscribe
    handler: HandleExampleCreated
    projection: {{.ProjectionID}}
  - contract: projection.{{.CellNoDash}}.summary.v1
    role: provide
verify:
  unit:
    - unit.{{.SliceID}}.service
  contract:
    - contract.event.{{.CellNoDash}}.example.v1.subscribe
    - contract.projection.{{.CellNoDash}}.summary.v1.provide
allowedFiles:
  - cells/{{.CellID}}/slices/{{.SliceID}}/**
{{end}}

{{define "projection-service-go"}}// Package {{.SlicePackage}} implements the L3 CQRS projection for the {{.CellID}} cell.
// Replace the stub with real read-model construction logic that consumes
// event.{{.CellNoDash}}.example.v1 and materialises the {{.ProjectionID}} projection.
package {{.SlicePackage}}

import (
	"context"

	"github.com/ghbvf/gocell/kernel/outbox"
)

// Service is the projection service skeleton. Wire a store (ports.ProjectionStore)
// and any required dependencies via constructor parameters as the slice grows.
type Service struct{}

// NewService returns a new projection Service.
func NewService() *Service { return &Service{} }

// HandleExampleCreated applies an example.created event to the read-model
// projection. It implements cell.ProjectionApply: the transaction is ambient in
// ctx (persistence.TxFromContext); the harness commits this apply together with
// the checkpoint SaveOffset in one CellTx. Replace with real domain logic.
func (s *Service) HandleExampleCreated(ctx context.Context, event outbox.Entry) error {
	_ = ctx
	_ = event
	return nil
}
{{end}}

{{define "projection-service-test-go"}}package {{.SlicePackage}}

