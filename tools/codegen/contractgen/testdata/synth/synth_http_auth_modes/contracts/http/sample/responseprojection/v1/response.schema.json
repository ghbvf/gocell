{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http.sample.responseprojection.v1.response",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "score": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "lastSeenAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "required": ["id"]
    }
  },
  "required": ["data"]
}
