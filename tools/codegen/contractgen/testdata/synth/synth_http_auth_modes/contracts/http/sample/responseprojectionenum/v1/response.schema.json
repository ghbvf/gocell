{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http.sample.responseprojectionenum.v1.response",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "pending"]
        },
        "label": { "type": "string" }
      },
      "required": ["id", "status", "label"]
    }
  },
  "required": ["data"]
}
