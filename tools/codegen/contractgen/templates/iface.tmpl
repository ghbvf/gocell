{{template "contractHeader" .}}

package {{.PackageName}}
{{- if eq .Kind "http"}}

import "context"

// Service is the business interface that the {{.ContractID}} server cell must implement.
//
// The signature follows the typed-response-envelope strict-server pattern
// (PR-V1-CONTRACT-TYPED-RESPONSE-ENVELOPE):
//
//   - The Service implementation returns one of the generated typed
//     {{.Endpoint.HandlerMethod}}{Status}{Suffix} structs (each implements
//     {{.Endpoint.HandlerMethod}}ResponseObject declared in types_gen.go).
//     CH-04 governance enforces that this typed-response set matches
//     contract.yaml http.responses[] declaration exactly.
//   - The Go error return is reserved for *un-declared* framework 5xx
//     situations (panics, infrastructure faults). The generated handler
//     falls back to httputil.WriteError(err) on this path, which derives
//     the response status from errcode.Kind (or returns 500 for non-errcode
//     errors). Business 4xx / 5xx must be returned as a typed struct.
//
// ref: oapi-codegen pkg/codegen/templates/strict/strict-interface.tmpl@main
type Service interface {
	{{.Endpoint.HandlerMethod}}(ctx context.Context, req *Request) ({{.Endpoint.HandlerMethod}}ResponseObject, error)
}
{{- else if eq .Kind "grpc"}}

import (
	"context"

	{{.GRPC.ProtoAlias}} "{{.GRPC.ProtoImportPath}}"
)

// {{.GRPC.InterfaceName}} is the gRPC business interface that the
// {{.ContractID}} server cell must implement.
//
// Request and response are the proto-generated message types for service
// {{.GRPC.ServiceFQN}} (proto: {{.GRPC.ProtoPath}}); the import path is resolved
// from the proto go_package option via the contractgen ProtoRegistry
// (GRPC-PROTO-REGISTRY-SINGLE-SOURCE-01) — no hand-written import literal.
//
// ref: grpc/grpc-go protoc-gen-go-grpc {Service}Server interface
type {{.GRPC.InterfaceName}} interface {
{{- range .GRPC.Methods}}
	{{.MethodName}}(ctx context.Context, req *{{$.GRPC.ProtoAlias}}.{{.RequestType}}) (*{{$.GRPC.ProtoAlias}}.{{.ResponseType}}, error)
{{- end}}
}
{{- end}}
