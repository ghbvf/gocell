package {{.PackageName}}

import (
	"github.com/ghbvf/gocell/kernel/cell"
)

// NewProjectionRequest returns a record-ready cell.ProjectionRequest for the L3
// CQRS projection that consumes {{.ContractID}}. apply is the business
// event→state hook; projectionID/cellID/sliceID are injected by cellgen from
// slice+cell metadata at code-generation time. onReset may be nil (no
// read-model table to clear on rebuild Reset phase).
//
// Mirrors NewSubscription: the package-private spec var never leaks as a bare
// value — callers receive a fully-formed ProjectionRequest. cellgen is the only
// production caller (reg.RegisterProjection is funnel-locked to cell_gen.go by
// PROJECTION-REGISTER-FUNNEL-01).
func NewProjectionRequest(apply cell.ProjectionApply, projectionID, cellID, sliceID string, onReset cell.ProjectionResetHook) cell.ProjectionRequest {
	return cell.ProjectionRequest{
		Spec:         spec,
		ProjectionID: projectionID,
		CellID:       cellID,
		SliceID:      sliceID,
		Apply:        apply,
		OnReset:      onReset,
	}
}
