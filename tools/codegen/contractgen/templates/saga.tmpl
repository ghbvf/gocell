{{template "contractHeader" .}}

package {{.PackageName}}

import (
	"context"
	"encoding/json"
{{- if .Saga.NeedsTime}}
	"time"
{{- end}}

	"github.com/ghbvf/gocell/kernel/saga"
	"github.com/ghbvf/gocell/pkg/idutil"
)

// DefinitionID is the saga.Definition.ID for {{.ContractID}}. Enroll instances
// under this id; Register/BuildDefinition stamp it onto the built Definition.
const DefinitionID idutil.SafeID = {{printf "%q" .Saga.DefinitionID}}

// Impl is the typed business interface the orchestrating cell implements for
// {{.ContractID}}. Per kernel/saga's StepFunc contract, each step receives the
// previous step's output (the first step takes no typed input — the runtime
// feeds nil prevState to step 0); a step exposes a Compensate method only when
// it declares compensation. BuildDefinition adapts these to the untyped
// saga.StepFunc / saga.CompensateFunc via JSON (un)marshal of the step outputs.
type Impl interface {
{{- range .Saga.Steps}}
{{- if .IsFirst}}
	Run{{.GoName}}(ctx context.Context, inst *saga.Instance) ({{.OutputGoType}}, error)
{{- else}}
	Run{{.GoName}}(ctx context.Context, inst *saga.Instance, in {{.InputGoType}}) ({{.OutputGoType}}, error)
{{- end}}
{{- if .HasCompensate}}
	Compensate{{.GoName}}(ctx context.Context, inst *saga.Instance, out {{.OutputGoType}}) error
{{- end}}
{{- end}}
}

// BuildDefinition wires impl into the kernel saga.Definition for {{.ContractID}}.
// Compose multiple sagas with saga.NewInMemoryRegistry(a.BuildDefinition(x), ...).
func BuildDefinition(impl Impl) *saga.Definition {
	return &saga.Definition{
		ID: DefinitionID,
{{- if .Saga.TimeoutExpr}}
		Timeout: {{.Saga.TimeoutExpr}},
{{- end}}
{{- if .Saga.RetryPolicy}}
		RetryPolicy: {{template "sagaRetry" .Saga.RetryPolicy}},
{{- end}}
		Steps: []saga.Step{
{{- range .Saga.Steps}}
			{
				Name: {{printf "%q" .Name}},
{{- if .TimeoutExpr}}
				Timeout: {{.TimeoutExpr}},
{{- end}}
{{- if .RetryPolicy}}
				RetryPolicy: {{template "sagaRetry" .RetryPolicy}},
{{- end}}
				Run: func(ctx context.Context, inst *saga.Instance, prevState []byte) ([]byte, error) {
{{- if .IsFirst}}
					out, err := impl.Run{{.GoName}}(ctx, inst)
{{- else}}
					var in {{.InputGoType}}
					if err := json.Unmarshal(prevState, &in); err != nil {
						return nil, err
					}
					out, err := impl.Run{{.GoName}}(ctx, inst, in)
{{- end}}
					if err != nil {
						return nil, err
					}
					return json.Marshal(out)
				},
{{- if .HasCompensate}}
				Compensate: func(ctx context.Context, inst *saga.Instance, committedState []byte) error {
					var out {{.OutputGoType}}
					if err := json.Unmarshal(committedState, &out); err != nil {
						return err
					}
					return impl.Compensate{{.GoName}}(ctx, inst, out)
				},
{{- end}}
			},
{{- end}}
		},
	}
}

// Register builds the definition for {{.ContractID}} and returns a one-saga
// saga.InMemoryRegistry holding it (which runs Definition.Validate).
func Register(impl Impl) (*saga.InMemoryRegistry, error) {
	return saga.NewInMemoryRegistry(BuildDefinition(impl))
}

{{- define "sagaRetry" -}}
saga.RetryPolicy{ {{- if .MaxAttempts}}MaxAttempts: {{.MaxAttempts}},{{end}}{{if .BaseIntervalExpr}} BaseInterval: {{.BaseIntervalExpr}},{{end}}{{if .MaxIntervalExpr}} MaxInterval: {{.MaxIntervalExpr}},{{end}} }
{{- end}}
