# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
.venv/
bin/
dist/
/gocell
/ssobff
/corebundle
/pg-migrate

# Example module binaries produced by running `go build` inside examples/<name>/.
/examples/corebundlestarter/corebundlestarter
/examples/iotdevice/iotdevice
/examples/orderfulfillment/orderfulfillment
/examples/ssobff/ssobff
/examples/todoorder/todoorder

# cmd/corebundle is its own go.work module (#1559); a bare `go build ./...` inside
# it leaves an in-dir binary (the canonical build uses `-o bin/`). Ignore it so it
# is never committed (mirrors the examples/<name>/ binaries above).
/cmd/corebundle/corebundle

# Test
*.test
*.out
coverage.html
coverage.txt

# Go workspace: go.work is committed (single-repo monorepo, all modules in-tree —
# per go.dev/ref/mod#workspaces "modules developed exclusively together" exception).
# go.work.sum stays local (single-module produces none; multi-module content is path-dependent).
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Debug
__debug_bin*

# Temporary
/.claude/tools/
tmp/
*.tmp

# Local env files (e.g. tests/e2e/.env.e2e); .env.e2e.example is committed
*.env.e2e
.env.e2e

# Local docker deploy secrets (generated by scripts/gen-deploy-secrets.sh)
.env.local
*.env.local

# Claude Code
worktrees/
.claude/scheduled_tasks.lock

# orderfulfillment example binary (compiled artifact)
/orderfulfillment

# Legacy src/ directory (flattened in PR#116, may contain stale build artifacts)
src/

# Generated (tracked selectively)
# generated/ files are committed but regenerated by `gocell generate`
bak/

# cmd/corebundle/catalog_gen.go is generated by `go generate ./cmd/corebundle/`.
# Not committed because go/packages.Load reports slightly different .Imports
# across macOS and Linux for production packages whose internal _test.go
# imports diverge from production imports (a known go/packages quirk).
# Committing the file guarantees byte-equal drift on every cross-platform CI
# run. Each consumer (CI, local build, prod build) generates its own copy
# before `go build ./cmd/corebundle/`. See docs/guides/devtools-catalog.md.
cmd/corebundle/catalog_gen.go
