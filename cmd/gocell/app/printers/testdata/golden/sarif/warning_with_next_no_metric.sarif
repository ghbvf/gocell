{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gocell",
          "version": "test-1.0.0",
          "informationUri": "https://github.com/ghbvf/gocell",
          "rules": [
            {
              "id": "ADV-05",
              "shortDescription": {
                "text": "event contract \"dead\" is active but has no subscribers; add a subscribing slice (contractUsages[role=subscribe] in slice.yaml), add an external actorSubscribers entry, or set lifecycle: deprecated"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ADV-05",
          "level": "warning",
          "message": {
            "text": "event contract \"dead\" is active but has no subscribers; add a subscribing slice (contractUsages[role=subscribe] in slice.yaml), add an external actorSubscribers entry, or set lifecycle: deprecated (field: lifecycle)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "contracts/event/dead/v1/contract.yaml",
                  "uriBaseId": "SRCROOT"
                }
              }
            }
          ],
          "properties": {
            "fix": "declare contractUsages[role=subscribe] in a slice.yaml, add an actorSubscribers entry, or set lifecycle: deprecated",
            "next": "advisory"
          }
        }
      ],
      "originalUriBaseIds": {
        "SRCROOT": {}
      }
    }
  ]
}
