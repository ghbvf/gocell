{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http.orderfulfillment.orderstatus.v1.response",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "status": {
          "type": "string",
          "description": "Saga terminal state: accepted (enrolled, not yet terminal) | running (in-progress) | succeeded | compensated | failed"
        }
      },
      "required": ["orderId", "status"]
    }
  },
  "required": ["data"]
}
