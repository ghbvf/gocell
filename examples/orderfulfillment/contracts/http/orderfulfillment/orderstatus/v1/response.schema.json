{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http.orderfulfillment.orderstatus.v1.response",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["accepted", "running", "succeeded", "compensated", "failed"],
          "description": "Saga state derived from the journal: accepted (enrolled, not yet terminal), running (in-progress), succeeded, compensated, failed."
        }
      },
      "required": ["orderId", "status"]
    }
  },
  "required": ["data"]
}
