{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http.order.projection-summary.v1.response",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "statuses": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              }
            }
          }
        },
        "totalOrders": {
          "type": "integer"
        }
      },
      "required": [
        "statuses",
        "totalOrders"
      ]
    }
  },
  "required": [
    "data"
  ]
}
