      "type": "object",
      "properties": {
        "statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              },
              "orderIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "totalOrders": {
          "type": "integer"
        },
        "lastAppliedSeq": {
          "type": "integer"
        }
      },
      "required": [
        "statuses",
        "totalOrders",
        "lastAppliedSeq"
      ]
    }
  },
  "required": [
    "data"
  ]
}
